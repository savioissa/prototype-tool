{
  "name": "ferramenta-prototipacao",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "proto:gerar": "tsx src/app/prototipador/gerador/main.ts",
    "proto:observar": "tsx src/app/prototipador/gerador/main.ts --observar",
    "proto:testar": "tsx --test src/app/prototipador/gerador/testes/*.test.ts",
    "prestart": "npm run proto:gerar",
    "start": "concurrently -k -n gerador,angular \"npm:proto:observar\" \"ng serve\"",
    "prebuild": "npm run proto:gerar",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "mermaid": "^12.3.0",
    "primeicons": "^7.0.0",
    "primeng": "^17.18.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "chokidar": "^3.6.0",
    "concurrently": "^10.0.7",
    "csv-parse": "^7.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.4.2"
  }
}
